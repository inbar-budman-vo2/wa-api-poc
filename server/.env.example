# Server
PORT=3001

# Send mode: mock (default, no Meta traffic) or live (requires Meta credentials below)
SEND_MODE=mock

# POC guardrails
# SEND_ALLOWLIST — optional in mock mode (omit or leave empty = any valid E.164 works).
# Required in live mode — comma-separated E.164, same numbers you OTP-verified in Meta.
# SEND_ALLOWLIST=+15551234567,+85291234567
MAX_SENDS_PER_DAY=20
MAX_SENDS_PER_RECIPIENT_PER_DAY=3
RECIPIENT_COOLDOWN_SECONDS=300
MESSAGE_TYPE=template

# Meta Cloud API (required for SEND_MODE=live — from Meta developer dashboard, Step 2)
WHATSAPP_ACCESS_TOKEN=EAA...
# Numeric ID from dashboard — not the +1... display number
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_WABA_ID=123456789012345
